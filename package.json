  "license": "MIT",
  "author": "BankConv (https://bankconv.com)",
  "type": "module",
  "bin": {
    "bankconv-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
